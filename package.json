{
  "name": "@gitupcms/gitup-serp",
  "version": "0.1.0",
  "description": "Self-hosted Google SERP API, CLI and MCP server with a Cloudflare Workers egress",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitupcms/gitup-serp.git"
  },
  "homepage": "https://github.com/gitupcms/gitup-serp#readme",
  "bugs": "https://github.com/gitupcms/gitup-serp/issues",
  "keywords": [
    "serp",
    "google",
    "scraper",
    "search",
    "mcp",
    "cloudflare-workers",
    "hono"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "bin": {
    "gitup-serp": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "src",
    "worker/src",
    "worker/tsconfig.json",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "cli": "tsx --env-file-if-exists=.env src/cli/index.ts",
    "mcp": "tsx --env-file-if-exists=.env src/mcp/index.ts",
    "canary": "tsx --env-file-if-exists=.env src/cli/canary.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "egress:up": "tsx --env-file-if-exists=.env src/egress/cli.ts up",
    "egress:down": "tsx --env-file-if-exists=.env src/egress/cli.ts down",
    "egress:ls": "tsx --env-file-if-exists=.env src/egress/cli.ts ls",
    "setup": "mkdir -p bin && curl -fsSL https://github.com/lexiforest/curl-impersonate/releases/download/v2.3.2/curl-impersonate-v2.3.2.x86_64-linux-gnu.tar.gz | tar -xz -C bin && PLAYWRIGHT_BROWSERS_PATH=.browsers patchright install chromium"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "cheerio": "^1.2.0",
    "cuimp": "^2.1.2",
    "esbuild": "^0.28.2",
    "hono": "^4.13.18",
    "patchright": "^1.64.3",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
