# Cloudflare egress (default): token with "Edit Cloudflare Workers" permission
CF_API_TOKEN=
CF_ACCOUNT_ID=
# Or any HTTP proxy instead of Cloudflare; {session} = sticky exit per identity
# SCRAPER_PROXY=http://user-{session}:pass@host:port
# Paid proxy used only while Google blocks the Cloudflare egress; starts on demand, closes after FALLBACK_IDLE_S (600)
# FALLBACK_PROXY=http://user-{session}:pass@host:port
# Last fallback while Google refuses, Cloudflare egress only: DuckDuckGo results, marked search_metadata.engine
# ENGINE_FALLBACK=duckduckgo
# OPENSERP_API_KEY=
# POOL_SIZE=1
# Country/language when a request gives none (exits sit in many countries); DEFAULT_GL= for no default
# DEFAULT_GL=us
# DEFAULT_HL=en
# Behind a reverse proxy that sets X-Forwarded-For: rate-limit per forwarded client address
# TRUST_PROXY=false
# Cache successful pages this many seconds (0 = off), keeping at most CACHE_MAX
# CACHE_TTL_S=120
# CACHE_MAX=1000
# Page extractions at once (/extract, extract=N); they go through the egress
# EXTRACT_PARALLEL=3
